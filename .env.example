# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.

########################################
# 🏛️ HashiCorp Vault Enterprise
########################################
# Vault Enterprise license string (required — get from HashiCorp portal)
VAULT_LICENSE=

########################################
# 🗄️ PostgreSQL
########################################
# These are the Vault management credentials only — used once by Terraform
# to configure the Database secrets engine. The Durin backend uses Vault
# dynamic credentials at runtime, never these static values.
POSTGRES_USER=durin
POSTGRES_PASSWORD=durin
POSTGRES_DB=durin_db

########################################
# 🔐 Vault AppRole — durin-backend
########################################
# After make tf-apply: terraform -chdir=terraform/vault-platform output -raw approle_durin_backend_role_id
DURIN_VAULT_ROLE_ID=
DURIN_VAULT_ROLE_NAME=durin-backend

########################################
# 🔐 Vault AppRole — vault-rotator
########################################
# The rotator uses its own narrow AppRole credential to generate new
# secret-ids for durin-backend. After make tf-apply:
#   ROTATOR_ROLE_ID   = terraform -chdir=terraform/vault-platform output -raw approle_durin_rotator_role_id
#   ROTATOR_SECRET_ID = vault write -f -field=secret_id auth/approle/role/durin-rotator/secret-id
ROTATOR_ROLE_ID=
ROTATOR_SECRET_ID=

########################################
# 🆔 Identity (Keycloak + LDAP)
########################################
KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD: # Moved to Vault KV (secret/durin/identity/*) — see scripts/identity-secrets.sh
# Public hostname for the Keycloak browser-facing URL (issuer claim, redirects)
KC_HOSTNAME=http://localhost:8083

# LDAP_ADMIN_PASSWORD: # Moved to Vault KV (secret/durin/identity/*) — see scripts/identity-secrets.sh

# OIDC client secret — generated by make identity-bootstrap, never commit
DURIN_OIDC_CLIENT_ID=durin-backend
# DURIN_OIDC_CLIENT_SECRET: # Moved to Vault KV (secret/durin/identity/*) — see scripts/identity-secrets.sh

# Public base URL for the Durin frontend (used for OIDC redirect URIs)
DURIN_BASE_URL=http://localhost:3000

# Backend RBAC — set to true once the identity stack (Keycloak) is running.
# When false (default), all auth checks pass with a synthetic demo identity.
DURIN_AUTH_ENABLED=false
DURIN_JWKS_URI=http://localhost:8083/realms/durin/protocol/openid-connect/certs
DURIN_OIDC_ISSUER=http://localhost:8083/realms/durin
DURIN_OIDC_AUDIENCE=durin-api

########################################
# 📊 Observability
########################################
# Grafana host port: 3010 (frontend owns 3000)
# Prometheus: 9090
# OTel: 4317 (gRPC) / 4318 (HTTP)
# No extra vars needed — all defaults work for local development
