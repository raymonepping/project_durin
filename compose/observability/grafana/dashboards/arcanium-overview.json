{
  "uid": "arcanium-overview",
  "title": "Arcanium — Platform Overview",
  "tags": ["arcanium"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "Vault nodes up", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(up{job=\"vault\"} == 1)", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 3 }] } } }
    },
    {
      "type": "stat", "title": "API request rate (req/s)", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(rate(arcanium_http_requests_total[5m]))", "refId": "A" }]
    },
    {
      "type": "stat", "title": "API error rate (5xx/s)", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(arcanium_http_requests_total{status=~\"5..\"}[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } } }
    },
    {
      "type": "stat", "title": "Crypto ops rate (ops/s)", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(rate(arcanium_crypto_operations_total[5m]))", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "API request rate by route", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (route) (rate(arcanium_http_requests_total[5m]))", "refId": "A", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries", "title": "API p99 latency (s)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(arcanium_http_request_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p99" }]
    },
    {
      "type": "timeseries", "title": "Vault request rate (per node)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum by (node) (rate(vault_core_handle_request_count[5m]))", "refId": "A", "legendFormat": "{{node}}" }]
    },
    {
      "type": "timeseries", "title": "Provisioning jobs by outcome", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "sum by (status) (increase(arcanium_provisioning_jobs_total[1h]))", "refId": "A", "legendFormat": "{{status}}" }]
    }
  ]
}
