# ── Added by commit_gh --harden ─────────────────────────────
*.env
.vault.*
*.vault
*.jsonl
input/*
!input/.gitkeep
output/*
!output/.gitkeep
compose/observability/prometheus/vault-token

# state/ capture staging — an in-progress or failed capture-state.sh run
# (Prompt 00 atomic capture: built in .tmp, only renamed into
# state/baselines/ once validated). Never a finalized baseline; must never
# be swept into a commit by accident.
state/.capture-*.tmp/

########################################
# 🎨 Prompt 00 — frontend design toolchain / quality gate
########################################
# Playwright CLI's own session/snapshot/console-log working files and
# generated visual-development artifacts (before/after screenshots) — never
# durable configuration or reports, regenerated on every run.

compose/identity/ldap/bootstrap.ldif
.agents
.claude
.codex