########################################
# 🎨 Prompt 00 — Impeccable's platform-specific compiled binary.
# SKILL.md / reference/*.md / the bundled JS are portable and committed
# so the skill works for any collaborator without re-running the
# installer; the native darwin-arm64 (or any other platform's) binary
# would not even run on a different OS/arch and is re-fetched by
# `npx impeccable install` on any machine that needs it, same reasoning
# as the Terraform provider binary above.
########################################
**/skills/impeccable/scripts/bin/

# Claude Code's own convention: settings.local.json is per-developer/
# per-machine, never the shared/committed settings.json.
.claude/settings.local.json
justfile
# tfvars often carry real credentials — commit .tfvars.example instead
*.tfvars
!*.tfvars.example
!*.tfvars.sample

